# Official sign-in for Post Everywhere. Copy to .env (git ignores it), fill in the values yourself,
# then: chmod 600 .env && npm run connect-check. Every app registers the same redirect URI:
#   https://northbound-dev.com/connect/callback.html
# YouTube (Google Cloud project, YouTube Data API v3, OAuth client of type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Pages + Instagram (Meta Business app, Facebook Login for Business configuration id)
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# TikTok (Login Kit for Web + Content Posting API, Upload)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# LinkedIn (optional: Share on LinkedIn + Sign In with OpenID)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
