{
  "name": "northbound-poster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "node src/cli.ts login",
    "status": "node src/cli.ts status",
    "post": "node src/cli.ts post",
    "weekly": "node src/weekly/build.ts",
    "tip": "node src/weekly/tip-build.ts",
    "weekly:list": "node src/weekly/list.ts",
    "weekly:approve": "node src/weekly/approve.ts",
    "test": "POSTER_APP_DIR=\"$(mktemp -d)\" node --test src/weekly/weekly.test.ts src/app.test.ts src/devices.test.ts src/security.test.ts src/maker/maker.test.ts src/maker/formats.test.ts src/platforms/platforms.test.ts src/hardening.test.ts src/remote.test.ts src/abuse.test.ts src/bundle.test.ts src/official/official.test.ts",
    "typecheck": "bunx tsc --noEmit",
    "dashboard": "node src/server.ts",
    "remote": "node src/remote.ts",
    "app": "node src/server.ts",
    "build:me": "cd desktop && node build.mjs --flavor=me",
    "build:client": "cd desktop && node build.mjs --flavor=client",
    "connect-check": "node src/official/check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "mp4-muxer": "5",
    "playwright-core": "^1.52.0",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.6.0"
  }
}
